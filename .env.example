# ==============================================================================
# OFC360 Frontend - Environment Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# Note: In production builds, only VITE_* variables are exposed to the client bundle.
# ==============================================================================

# Application Metadata
VITE_APP_NAME=OFC360
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# Backend API Base URL (Do not include trailing slash)
VITE_API_BASE_URL=https://api.ofc360.com

# Cookie & Session Configuration
# In production, cookies are httpOnly and managed strictly by the backend.
VITE_AUTH_COOKIE_DOMAIN=.ofc360.com
VITE_AUTH_TOKEN_HEADER=Authorization

# Google OAuth Client ID (Required for Google Identity Services SSO in Phase 2)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Feature Flags & Debugging
VITE_ENABLE_MOCK_FALLBACK=false