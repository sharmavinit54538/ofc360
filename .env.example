# ========================================================
# OFC360 Frontend - Environment Template (.env.example)
# ========================================================

VITE_APP_NAME=OFC360
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# Backend API Base URL
VITE_API_BASE_URL=https://api.ofc360.com/api/v1

# Feature Flags
VITE_ENABLE_MOCK_FALLBACK=false
VITE_AI_INTERVIEW_ENABLED=true

# Optional canonical origin for public career, job application, and referral URLs.
# If empty, non-localhost window origin is used, otherwise https://www.ofc360.com.
VITE_PUBLIC_APP_URL=
