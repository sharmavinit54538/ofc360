# ========================================================
# OFC360 Enterprise Frontend Production Configuration
# ========================================================

# App Metadata
VITE_APP_NAME=OFC360
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# Backend API Configuration
VITE_API_BASE_URL=https://api.ofc360.com/api/v1

# Security & Session Settings
VITE_AUTH_COOKIE_DOMAIN=.ofc360.com
VITE_AUTH_TOKEN_HEADER=Authorization

# Feature Flags
VITE_ENABLE_MOCK_FALLBACK=false
